<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== BASE THEME ===== -->
    <style name="Base.Theme.TirTirMCommerce" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tirtir_aura_pink</item>
        <item name="colorPrimaryDark">@color/tirtir_milk_white</item>
        <item name="colorAccent">@color/tirtir_aura_pink</item>
        <item name="colorOnPrimary">@color/tirtir_text_primary</item>
        <item name="android:windowBackground">@color/tirtir_bg_gray</item>
        <item name="android:statusBarColor">@color/tirtir_milk_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.TirTirMCommerce" parent="Base.Theme.TirTirMCommerce" />

    <!-- ===== BUTTON STYLES ===== -->
    <style name="Widget.TirTir.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/tirtir_red_primary</item>
        <item name="android:textColor">@color/tirtir_milk_white</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.TirTir.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/tirtir_red_primary</item>
        <item name="android:textColor">@color/tirtir_red_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- ===== TEXT INPUT STYLES ===== -->
    <style name="Widget.TirTir.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/tirtir_red_primary</item>
        <item name="hintTextColor">@color/tirtir_red_primary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- ===== CARD STYLES ===== -->
    <style name="Widget.TirTir.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/tirtir_milk_white</item>
    </style>

    <!-- ===== TEXT STYLES ===== -->
    <style name="TextAppearance.TirTir.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/tirtir_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TirTir.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/tirtir_text_secondary</item>
    </style>

    <style name="TextAppearance.TirTir.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/tirtir_silver_gray</item>
    </style>

</resources>
