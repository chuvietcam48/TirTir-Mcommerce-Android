<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-transparent dark background for glassmorphism effect -->
    <solid android:color="#99000000" />
    <!-- Rounded corners -->
    <corners android:radius="24dp" />
    <!-- Subtle white border for the frosted glass edge -->
    <stroke android:width="1dp" android:color="#4DFFFFFF" />
    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp" />
</shape>
