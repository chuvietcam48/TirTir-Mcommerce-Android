<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/tirtir_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Product Image with Restock Badge overlay -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <ImageView
                android:id="@+id/imgWishlistProduct"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:scaleType="centerCrop"
                android:background="@color/tirtir_off_white"
                android:src="@drawable/ic_product_placeholder" />

            <!-- Restock Alert badge — GONE by default, PM sets VISIBLE on FCM restock payload -->
            <TextView
                android:id="@+id/tvRestockBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:background="@color/tirtir_success"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:text="Về hàng"
                android:textColor="@color/tirtir_white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Product Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvWishlistProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/tirtir_black"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvWishlistProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 đ"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/tirtir_red_primary" />

        </LinearLayout>

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/btnRemoveWishlist"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/tirtir_text_secondary"
            android:contentDescription="Remove from wishlist" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
