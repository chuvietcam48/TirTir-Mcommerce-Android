<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/ivInsightIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_star_filled"
        app:tint="@color/tirtir_red_primary"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvInsightTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Insight Title"
            android:textColor="@color/tirtir_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"/>

        <TextView
            android:id="@+id/tvInsightDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Insight Description"
            android:textColor="@color/tirtir_text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>
</LinearLayout>
