<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/tirtir_white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/tirtir_border_gray">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Product image — 1:1 ratio via paddingBottom trick on container -->
        <FrameLayout
            android:id="@+id/frameImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/tirtir_off_white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1">

            <ImageView
                android:id="@+id/ivProductImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/tirtir_off_white" />

            <TextView
                android:id="@+id/tvImageFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="TIRTIR"
                android:textColor="@color/tirtir_red_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <!-- Out-of-stock overlay badge -->
            <TextView
                android:id="@+id/tvOutOfStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Out"
                android:textColor="@color/tirtir_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#CC111111"
                android:visibility="gone" />

            <!-- Wishlist heart icon — top right -->
            <ImageButton
                android:id="@+id/btnWishlistToggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_wishlist"
                app:tint="@color/tirtir_text_secondary"
                android:scaleType="centerInside"
                android:contentDescription="Wishlist"
                android:padding="4dp" />
                
            <!-- Discount badge -->
            <TextView
                android:id="@+id/tvDiscountBadge"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/ic_tirtir_brand_circle"
                android:backgroundTint="@color/tirtir_red_primary"
                android:textColor="@color/tirtir_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:text="-10%"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Category label -->
        <TextView
            android:id="@+id/tvProductCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:text="CATEGORY"
            android:textColor="@color/tirtir_red_primary"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            app:layout_constraintTop_toBottomOf="@id/frameImage"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Product name -->
        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Product Name"
            android:textColor="@color/tirtir_black"
            android:textSize="13sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvProductCategory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Price -->
        <TextView
            android:id="@+id/tvProductPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:text="0 đ"
            android:textColor="@color/tirtir_black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvProductName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnQuickAdd"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickAdd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Quick add"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:backgroundTint="@color/tirtir_black"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_cart"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/tirtir_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
