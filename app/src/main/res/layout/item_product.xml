<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/tirtir_white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/tirtir_rose_outline">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Product Image area (square) -->
        <FrameLayout
            android:id="@+id/cardImageContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/tirtir_bg_gray"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1">

            <ImageView
                android:id="@+id/ivProductImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvImageFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="TIRTIR"
                android:textColor="@color/tirtir_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Sale badge (top-left) -->
            <TextView
                android:id="@+id/tvDiscountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_tag_primary"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:textColor="@color/tirtir_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="-10%"
                android:visibility="gone" />

            <!-- Out-of-stock overlay -->
            <TextView
                android:id="@+id/tvOutOfStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Sold Out"
                android:textColor="@color/tirtir_white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="#CC111111"
                android:visibility="gone" />

            <!-- Wishlist heart (top-right) -->
            <ImageButton
                android:id="@+id/btnWishlistToggle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_wishlist"
                app:tint="@color/tirtir_text_secondary"
                android:scaleType="centerInside"
                android:contentDescription="Wishlist" />

        </FrameLayout>

        <!-- Product info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardImageContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Milk Toner"
                android:textColor="@color/tirtir_black"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.1" />

            <TextView
                android:id="@+id/tvProductCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Soothing Rice Bran"
                android:textColor="@color/tirtir_text_secondary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Price row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <!-- Price column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$35.00"
                        android:textColor="@color/tirtir_text_secondary"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvProductPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$28.00"
                        android:textColor="@color/tirtir_red_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Quick add -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickAdd"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:iconSize="18dp"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/tirtir_red_primary"
                    app:cornerRadius="17dp"
                    app:icon="@drawable/ic_plus"
                    app:iconTint="@color/tirtir_white"
                    android:contentDescription="Add to cart" />

            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
