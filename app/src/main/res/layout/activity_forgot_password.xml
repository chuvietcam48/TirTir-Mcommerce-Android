<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tirtir_off_white">

    <!-- Custom Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="Back">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT RECOVERY"
            android:textColor="@color/tirtir_red_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_gravity="center" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot Password?"
                android:textColor="@color/tirtir_red_dark"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter your email address and we'll send you a verification code to reset your password."
                android:textColor="@color/tirtir_text_secondary"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="48dp" />

            <!-- Email Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL ADDRESS"
                android:textColor="@color/tirtir_black"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_auth_underline"
                android:hint="e.g., curator@tirtir.beauty"
                android:textColorHint="@color/tirtir_text_hint"
                android:inputType="textEmailAddress"
                android:paddingBottom="8dp"
                android:textSize="15sp"
                android:layout_marginBottom="48dp" />

            <!-- Send Code Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/tirtir_dark_gray_btn"
                android:text="SEND CODE"
                android:textColor="@color/tirtir_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                app:cornerRadius="4dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="\u24D8 Contact Concierge Support"
                android:textColor="@color/tirtir_text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="32dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
