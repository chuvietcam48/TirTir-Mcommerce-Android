<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tirtir_off_white">

    <!-- =================== TOP BAR =================== -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tirtir_white"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarHome"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="TirTir"
            app:titleTextColor="@color/tirtir_red_primary"
            app:layout_scrollFlags="scroll|enterAlways">
            
            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchViewProducts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                app:iconifiedByDefault="true"
                app:queryHint="Search products..." />
                
        </androidx.appcompat.widget.Toolbar>
            
        <com.google.android.gms.ads.AdView
            android:id="@+id/adViewSlot"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/tirtir_bg_gray"
            android:visibility="gone"
            app:adSize="BANNER"
            app:adUnitId="ca-app-pub-3940256099942544/6300978111" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                            android:text="Category:"
                    android:textSize="14sp"
                    android:textColor="@color/tirtir_black"
                    android:layout_marginEnd="8dp"/>

                <Spinner
                    android:id="@+id/spinnerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner_outline"
                    android:paddingHorizontal="12dp"
                    android:popupBackground="@color/tirtir_white" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSkinTypeFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAll"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterOily"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oily" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterDry"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dry" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterCombo"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Combination" />
                        
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterSensitive"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sensitive" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fadeScrollbars="false"
                android:fadingEdgeLength="24dp"
                android:overScrollMode="never"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutHomeAiActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="20dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHomeChat"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="128dp"
                        android:layout_marginEnd="8dp"
                        android:text="AI Advisor"
                        android:textColor="@color/tirtir_red_primary"
                        app:cornerRadius="22dp"
                        app:icon="@drawable/ic_chat"
                        app:iconTint="@color/tirtir_red_primary"
                        app:strokeColor="@color/tirtir_red_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHomeSkin"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="150dp"
                        android:layout_marginEnd="8dp"
                        android:text="Skin Analysis"
                        android:textColor="@color/tirtir_red_primary"
                        app:cornerRadius="22dp"
                        app:icon="@drawable/ic_skin"
                        app:iconTint="@color/tirtir_red_primary"
                        app:strokeColor="@color/tirtir_border_gray" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHomeScan"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="166dp"
                        android:text="Ingredient Scan"
                        android:textColor="@color/tirtir_red_primary"
                        app:cornerRadius="22dp"
                        app:icon="@drawable/ic_scan"
                        app:iconTint="@color/tirtir_red_primary"
                        app:strokeColor="@color/tirtir_border_gray" />
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- =================== CONTENT =================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Product grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProducts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2" />

        <!-- Loading spinner -->
        <ProgressBar
            android:id="@+id/progressProducts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutLoadingState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/tvLoadingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Loading TirTir products...\nShowing cached items first when available."
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/tirtir_black"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutErrorState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="@color/tirtir_text_secondary" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Unable to load products."
                android:textSize="15sp"
                android:textColor="@color/tirtir_black"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Retry"
                android:textColor="@color/tirtir_white"
                android:paddingHorizontal="32dp"
                app:backgroundTint="@color/tirtir_red_primary"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutEmptyProducts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/tirtir_silver_gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No matching products"
                android:textSize="15sp"
                android:textColor="@color/tirtir_text_secondary"
                android:gravity="center" />
        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
