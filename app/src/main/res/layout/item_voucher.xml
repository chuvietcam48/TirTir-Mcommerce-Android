<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/tirtir_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Discount percentage banner -->
        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="100dp"
            android:background="@color/tirtir_red_primary"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvVoucherDiscountPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10%"
                android:textColor="@color/tirtir_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GIẢM"
                android:textColor="@color/tirtir_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:alpha="0.8" />
        </LinearLayout>

        <!-- Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvVoucherCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIRTIR-ABC123"
                android:textColor="@color/tirtir_black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvVoucherExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hạn dùng: 19/07/2026"
                android:textColor="@color/tirtir_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Copy button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyVoucher"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Sao chép"
            android:textColor="@color/tirtir_red_primary"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
