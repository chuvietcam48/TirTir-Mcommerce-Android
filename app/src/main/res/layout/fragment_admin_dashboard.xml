<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="16dp">

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_search_bar"
            android:backgroundTint="@color/tirtir_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/tirtir_text_secondary" />

            <EditText
                android:id="@+id/etAdminSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Search"
                android:textColor="@color/tirtir_black"
                android:textColorHint="@color/tirtir_text_secondary"
                android:textSize="16sp"
                android:inputType="text"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 2x2 Grid of Cards -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginBottom="24dp">

            <!-- Total Visitors -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/tirtir_outline_variant"
                app:strokeWidth="1dp">
                <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_rounded_border" android:backgroundTint="#0D610000">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_group" app:tint="@color/tirtir_primary" android:layout_gravity="center"/>
                        </FrameLayout>
                        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvVisitorsTrend" android:text="+4.8%" android:textSize="10sp" android:textStyle="bold" android:textColor="#16A34A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <ImageView android:id="@+id/ivVisitorsTrendIcon" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_trending_up" app:tint="#16A34A" android:layout_marginStart="2dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvVisitors" android:text="—" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/tirtir_black" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="TOTAL VISITORS" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/tirtir_text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Total Orders -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/tirtir_outline_variant"
                app:strokeWidth="1dp">
                <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_rounded_border" android:backgroundTint="#0D610000">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_cart" app:tint="@color/tirtir_primary" android:layout_gravity="center"/>
                        </FrameLayout>
                        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvOrdersTrend" android:text="+2.5%" android:textSize="10sp" android:textStyle="bold" android:textColor="#16A34A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <ImageView android:id="@+id/ivOrdersTrendIcon" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_trending_up" app:tint="#16A34A" android:layout_marginStart="2dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvOrders" android:text="—" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/tirtir_black" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="TOTAL ORDERS" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/tirtir_text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- App Sessions -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/tirtir_outline_variant"
                app:strokeWidth="1dp">
                <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_rounded_border" android:backgroundTint="#0D610000">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_visibility" app:tint="@color/tirtir_primary" android:layout_gravity="center"/>
                        </FrameLayout>
                        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvViewsTrend" android:text="-1.8%" android:textSize="10sp" android:textStyle="bold" android:textColor="#EF4444" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <ImageView android:id="@+id/ivViewsTrendIcon" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_trending_down" app:tint="#EF4444" android:layout_marginStart="2dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvViews" android:text="—" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/tirtir_black" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="APP SESSIONS" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/tirtir_text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Conversion -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/tirtir_outline_variant"
                app:strokeWidth="1dp">
                <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_rounded_border" android:backgroundTint="#0D610000">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_conversion_path" app:tint="@color/tirtir_primary" android:layout_gravity="center"/>
                        </FrameLayout>
                        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvConversionTrend" android:text="+2.0%" android:textSize="10sp" android:textStyle="bold" android:textColor="#16A34A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <ImageView android:id="@+id/ivConversionTrendIcon" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_trending_up" app:tint="#16A34A" android:layout_marginStart="2dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvConversion" android:text="—" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/tirtir_black" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="CONVERSION" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/tirtir_text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- Critical Alerts -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Critical Alerts"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/tirtir_black"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:id="@+id/llAlertsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"/>

        <!-- Target Orders Gauge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/tirtir_outline_variant"
            app:strokeWidth="1dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Target Orders"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/tirtir_black"/>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_filter"
                        app:tint="@color/tirtir_text_secondary"/>
                </LinearLayout>
                
                <FrameLayout
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp">

                    <!-- Background ring (full circle, grey) -->
                    <ProgressBar
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:progress="100"
                        android:progressDrawable="@drawable/bg_gauge_track"
                        android:layout_gravity="center"
                        android:rotation="-90" />

                    <!-- Foreground ring (actual progress) -->
                    <ProgressBar
                        android:id="@+id/pbTargetOrders"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:progressDrawable="@drawable/bg_gauge_progress"
                        android:max="100"
                        android:progress="0"
                        android:layout_gravity="center"
                        android:rotation="-90" />

                    <!-- Center text -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvTargetProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/tirtir_black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="orders"
                            android:textSize="11sp"
                            android:textColor="@color/tirtir_text_secondary" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTargetMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="13sp"
                    android:textColor="@color/tirtir_text_secondary"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Time Filter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="32dp">
            
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgTimeFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:background="@drawable/bg_rounded_border"
                android:backgroundTint="@color/tirtir_surface_container">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterToday"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="12sp"
                    app:cornerRadius="24dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterWeekly"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weekly"
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="12sp"
                    app:cornerRadius="24dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterMonthly"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monthly"
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="12sp"
                    app:cornerRadius="24dp"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Sales Report -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/tirtir_outline_variant"
            app:strokeWidth="1dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sales Report"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/tirtir_black"/>
                        
                    <TextView
                        android:id="@+id/tvReportPeriod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Week"
                        android:textSize="12sp"
                        android:textColor="@color/tirtir_text_secondary"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/bg_rounded_border"
                        app:drawableEndCompat="@drawable/ic_expand_more"
                        app:drawableTint="@color/tirtir_text_secondary"
                        android:drawablePadding="4dp"/>
                </LinearLayout>

                <!-- Table Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="16dp">
                    
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:text="NO"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/tirtir_text_secondary" />
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PRODUCT NAME"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/tirtir_text_secondary" />
                        
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="SOLD"
                        android:gravity="center"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/tirtir_text_secondary" />
                        
                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="PROFITS"
                        android:gravity="end"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/tirtir_text_secondary" />
                </LinearLayout>
                
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSalesReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
