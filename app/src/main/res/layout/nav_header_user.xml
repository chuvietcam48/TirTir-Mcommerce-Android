<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="196dp"
    android:background="@color/tirtir_red_surface"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="92dp"
        android:layout_height="30dp"
        android:contentDescription="TirTir"
        android:scaleType="centerInside"
        android:src="@drawable/ic_logo_black" />

    <TextView
        android:id="@+id/tvDrawerUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="TirTir Member"
        android:textColor="@color/tirtir_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDrawerUserEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="member@tirtir.com"
        android:textColor="@color/tirtir_text_secondary"
        android:textSize="13sp" />

</LinearLayout>
