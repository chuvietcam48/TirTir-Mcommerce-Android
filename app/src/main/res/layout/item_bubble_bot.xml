<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/ivBotAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_bot_avatar_premium"
        android:contentDescription="TIRTIR Beauty Advisor" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="64dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBotName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="TIRTIR Beauty Advisor"
            android:textColor="@color/tirtir_red_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/tvBotMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_bot"
            android:elevation="0dp"
            android:maxWidth="286dp"
            android:padding="16dp"
            android:textColor="#5a403c"
            android:textSize="14sp" />

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/flexRecommendedProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:flexWrap="wrap" />

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/flexBotActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:flexWrap="wrap" />

        <TextView
            android:id="@+id/tvBotTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/tirtir_text_hint"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
