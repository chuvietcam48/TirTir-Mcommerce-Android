<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tirtir_off_white">

    <!-- Shared header -->
    <include layout="@layout/layout_app_header" />

    <!-- ═══ QUIZ CONTAINER (visible for new users) ═══ -->
    <LinearLayout
        android:id="@+id/quizContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Quiz header: title + progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/tirtir_white"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skin Quiz"
                android:textColor="@color/tirtir_red_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ProgressBar
                    android:id="@+id/quizProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:max="6"
                    android:progress="1"
                    android:progressTint="@color/tirtir_red_primary"
                    android:progressBackgroundTint="@color/tirtir_bg_gray" />

                <TextView
                    android:id="@+id/tvQuizStepCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="1 / 6"
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Scrollable step content injected programmatically -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/stepContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="20dp" />
        </ScrollView>

        <!-- Navigation buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@color/tirtir_white"
            android:elevation="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuizBack"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Back"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:visibility="invisible"
                app:strokeColor="@color/tirtir_red_primary"
                android:textColor="@color/tirtir_red_primary"
                app:cornerRadius="10dp"
                android:layout_marginEnd="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuizNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Next"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textColor="@color/tirtir_white"
                app:backgroundTint="@color/tirtir_red_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ RESULT CONTAINER (visible after quiz) ═══ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/resultContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Routine header banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/tirtir_white"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Routine"
                        android:textColor="@color/tirtir_red_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSkinProfileLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="@color/tirtir_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetakeQuiz"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Retake Quiz"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/tirtir_red_primary"
                    app:strokeColor="@color/tirtir_red_primary"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Combo picks section -->
            <LinearLayout
                android:id="@+id/comboSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECOMMENDED SETS"
                    android:textColor="@color/tirtir_red_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/tirtir_red_primary" />

                <LinearLayout
                    android:id="@+id/comboProductsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- AM routine section -->
            <LinearLayout
                android:id="@+id/amSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MORNING ROUTINE"
                        android:textColor="@color/tirtir_red_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AM"
                        android:textColor="@color/tirtir_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="32dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/tirtir_red_primary" />

                <LinearLayout
                    android:id="@+id/amProductsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- PM routine section -->
            <LinearLayout
                android:id="@+id/pmSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="EVENING ROUTINE"
                        android:textColor="@color/tirtir_red_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PM"
                        android:textColor="@color/tirtir_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="32dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/tirtir_red_primary" />

                <LinearLayout
                    android:id="@+id/pmProductsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/routineEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No products matched your profile yet."
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="14sp"
                    android:gravity="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrowseShop"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="Browse Shop"
                    android:textAllCaps="false"
                    android:textColor="@color/tirtir_white"
                    app:backgroundTint="@color/tirtir_red_primary"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
