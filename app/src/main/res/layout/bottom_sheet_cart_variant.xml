<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tirtir_white"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View android:layout_width="40dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="18dp" android:background="@drawable/bg_sheet_handle" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Edit variant" android:textColor="@color/tirtir_red_dark" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvCartVariantProduct" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/tirtir_text_secondary" android:textSize="14sp" />
    <ProgressBar android:id="@+id/progressCartVariants" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipsCartVariants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:selectionRequired="true"
        app:singleSelection="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmCartVariant"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="22dp"
        android:text="Confirm selection"
        android:textColor="@color/tirtir_white"
        android:textStyle="bold"
        app:backgroundTint="@color/tirtir_red_dark"
        app:cornerRadius="8dp" />
</LinearLayout>
