<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tirtir_off_white"
    android:paddingBottom="?attr/actionBarSize">

    <!-- TopAppBar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAdminFlashSale"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#CCFFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/tirtir_red_dark"
                android:padding="8dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Marketing Center"
                android:textSize="24sp"
                android:textColor="@color/tirtir_red_dark"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:id="@+id/btnProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_profile"
                app:tint="@color/tirtir_red_dark"
                android:padding="8dp"/>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarAdminFlashSale"
        app:layout_constraintBottom_toTopOf="@id/bottomNavAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hero/Summary Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                
                <!-- Revenue Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/tirtir_surface_variant"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="REVENUE"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/tirtir_text_secondary"/>
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_admin_orders"
                                app:tint="@color/tirtir_red_dark"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvSummaryRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₩14.2M"
                            android:textSize="20sp"
                            android:textColor="@color/tirtir_black"
                            android:layout_marginTop="8dp"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_trending_up"
                                app:tint="@color/tirtir_success"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+12.5%"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/tirtir_success"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Active Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/tirtir_surface_variant"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ACTIVE"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/tirtir_text_secondary"/>
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_admin_campaign"
                                app:tint="@color/tirtir_red_dark"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvSummaryActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="03"
                            android:textSize="20sp"
                            android:textColor="@color/tirtir_black"
                            android:layout_marginTop="8dp"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_scan"
                                app:tint="@color/tirtir_red_dark"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="48h left"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/tirtir_red_dark"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Campaign List Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Flash Sale Manager"
                    android:textSize="20sp"
                    android:textColor="@color/tirtir_black"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_border_radius_24"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_filter"
                        app:tint="@color/tirtir_text_secondary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filter"
                        android:textSize="11sp"
                        android:textColor="@color/tirtir_text_secondary"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Campaign List (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFlashSales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_campaign"/>

            <!-- Create Form Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="48dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/tirtir_surface_variant"
                app:strokeWidth="1dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Create New Flash Sale"
                        android:textSize="24sp"
                        android:textAlignment="center"
                        android:textColor="@color/tirtir_black"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Configure and broadcast your promotion instantly."
                        android:textSize="12sp"
                        android:textAlignment="center"
                        android:textColor="@color/tirtir_text_secondary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="24dp"/>

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TITLE *"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/tirtir_text_secondary"/>
                    <EditText
                        android:id="@+id/etFlashSaleTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="e.g. 50% OFF All Skincare!"
                        android:textColorHint="@color/tirtir_text_hint"
                        android:textColor="@color/tirtir_black"
                        android:textSize="18sp"
                        android:paddingVertical="8dp"
                        android:layout_marginBottom="20dp"
                        android:inputType="text"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/tirtir_surface_variant" android:layout_marginTop="-20dp" android:layout_marginBottom="20dp"/>

                    <!-- Message -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MESSAGE *"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/tirtir_text_secondary"/>
                    <EditText
                        android:id="@+id/etFlashSaleMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="Describe your amazing promotion here..."
                        android:textColorHint="@color/tirtir_text_hint"
                        android:textColor="@color/tirtir_black"
                        android:textSize="16sp"
                        android:paddingVertical="8dp"
                        android:layout_marginBottom="20dp"
                        android:minLines="2"
                        android:gravity="top"
                        android:inputType="textMultiLine"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/tirtir_surface_variant" android:layout_marginTop="-20dp" android:layout_marginBottom="20dp"/>

                    <!-- Link & Image -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PATH"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="@color/tirtir_text_secondary"/>
                            <EditText
                                android:id="@+id/etFlashSalePath"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:hint="/products"
                                android:textColorHint="@color/tirtir_text_hint"
                                android:textColor="@color/tirtir_black"
                                android:textSize="16sp"
                                android:paddingVertical="8dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/tirtir_surface_variant" android:layout_marginTop="0dp"/>
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TARGET"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="@color/tirtir_text_secondary"/>
                            <EditText
                                android:id="@+id/etFlashSaleTarget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:hint="All users"
                                android:textColorHint="@color/tirtir_text_hint"
                                android:textColor="@color/tirtir_black"
                                android:textSize="16sp"
                                android:paddingVertical="8dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/tirtir_surface_variant" android:layout_marginTop="0dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSendFlashSale"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="24dp"
                        android:text="Blast Notification"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/tirtir_red_dark"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_send"
                        app:iconGravity="textStart"/>

                    <ProgressBar
                        android:id="@+id/pbFlashSaleLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Broadcasting will reach 12.4k active users."
                        android:textSize="10sp"
                        android:textAlignment="center"
                        android:textColor="@color/tirtir_text_secondary"
                        android:layout_marginTop="12dp"/>
                    
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Mockup -->
    <LinearLayout
        android:id="@+id/bottomNavAdmin"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:background="#E6FFFFFF"
        android:gravity="center"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_admin_dashboard" app:tint="@color/tirtir_text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dashboard" android:textSize="10sp" android:textColor="@color/tirtir_text_secondary" android:layout_marginTop="2dp"/>
        </LinearLayout>
        
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_admin_inventory" app:tint="@color/tirtir_text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Products" android:textSize="10sp" android:textColor="@color/tirtir_text_secondary" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_cart" app:tint="@color/tirtir_text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Orders" android:textSize="10sp" android:textColor="@color/tirtir_text_secondary" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_admin_campaign" app:tint="@color/tirtir_red_primary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Marketing" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/tirtir_red_primary" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
