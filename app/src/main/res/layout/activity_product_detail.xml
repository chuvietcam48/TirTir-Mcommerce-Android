<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tirtir_white">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarProductDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/product_detail_title"
            app:titleTextColor="@color/tirtir_text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Product image — real ImageView (Phase 1) -->
            <!-- ViewPager2 kept as invisible placeholder for future gallery (Phase 2) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="@color/tirtir_off_white">

                <ImageView
                    android:id="@+id/ivProductDetailImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/tirtir_off_white"
                    android:contentDescription="@string/product_name_placeholder" />

                <!-- Hidden ViewPager2 — Phase 2 gallery support placeholder -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerProductImages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabIndicatorImages"
                    android:layout_width="wrap_content"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="@android:color/transparent"
                    app:tabBackground="@drawable/tab_selector"
                    app:tabGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabPaddingEnd="2dp"
                    app:tabPaddingStart="2dp"
                    android:visibility="gone"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnARTryOn"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="28dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="TRY-ON"
                    android:textColor="@color/tirtir_white"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/tirtir_black_cover"
                    app:cornerRadius="19dp"
                    app:icon="@drawable/ic_scan"
                    app:iconSize="16dp"
                    app:iconTint="@color/tirtir_white" />

                <!-- Out-of-stock badge — GONE by default, VISIBLE when stock <= 0 -->
                <TextView
                    android:id="@+id/tvProductOutOfStockBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="#CC000000"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Out of stock"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvProductCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/product_category_placeholder"
                    android:textColor="@color/tirtir_red_primary"
                    android:textSize="14sp"
                    android:textAllCaps="true"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/product_name_placeholder"
                    android:textColor="@color/tirtir_text_primary"
                    android:textSize="26sp"
                    android:fontFamily="serif"
                    android:lineSpacingMultiplier="1.1"
                    android:textStyle="normal" />

                <!-- Rating row (stars + count) — hidden until API returns rating > 0 -->
                <LinearLayout
                    android:id="@+id/layoutRatingRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_star_filled"
                        app:tint="@color/tirtir_red_primary" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_star_filled"
                        app:tint="@color/tirtir_red_primary" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_star_filled"
                        app:tint="@color/tirtir_red_primary" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_star_filled"
                        app:tint="@color/tirtir_red_primary" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_star_filled"
                        app:tint="@color/tirtir_red_primary" />

                    <TextView
                        android:id="@+id/tvProductRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/tirtir_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Price row: sale price + original strikethrough -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvProductPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/product_price_placeholder"
                        android:textColor="@color/tirtir_black"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProductOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/tirtir_text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvProductDiscountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_tag_primary"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/tirtir_white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Feature badges (Vegan Formula / Dermatology Tested) — hidden until API confirms flags -->
                <LinearLayout
                    android:id="@+id/layoutFeatureBadges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardVeganFormula"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/tirtir_off_white"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/tirtir_rose_outline">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_badge_cruelty_free"
                                app:tint="@color/tirtir_red_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Vegan Formula"
                                android:textColor="@color/tirtir_black"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="100% plant-based"
                                android:textColor="@color/tirtir_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDermatologistTested"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/tirtir_off_white"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/tirtir_rose_outline">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_badge_dermatologist"
                                app:tint="@color/tirtir_red_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Dermatology Tested"
                                android:textColor="@color/tirtir_black"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Clinically proven safe"
                                android:textColor="@color/tirtir_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/tirtir_border_gray" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/product_suitable_skin_types"
                    android:textColor="@color/tirtir_text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvSuitableSkinTypes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/product_skin_types_placeholder"
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvHeaderIngredients"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="KEY INGREDIENTS  +"
                    android:textColor="@color/tirtir_text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvIngredientList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/product_ingredients_placeholder"
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChatAdvisor"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Ask AI before buying"
                    android:textColor="@color/tirtir_black"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_chat"
                    app:iconTint="@color/tirtir_black"
                    app:strokeColor="@color/tirtir_border_gray" />

                <LinearLayout
                    android:id="@+id/layoutShadeSelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SELECT SHADE"
                        android:textColor="@color/tirtir_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChooseShade"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Choose shade"
                        android:textColor="@color/tirtir_red_dark" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHeaderDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="DESCRIPTION  −"
                    android:textColor="@color/tirtir_text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvProductDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/product_description_placeholder"
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <!-- Container for Description Images (Phase 3) -->
                <LinearLayout
                    android:id="@+id/layoutDescriptionImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvHeaderHowToUse"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:text="HOW TO USE  +"
                    android:textColor="@color/tirtir_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHowToUse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Application directions are not available yet."
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHeaderReviews"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:text="REVIEWS  +"
                    android:textColor="@color/tirtir_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReviewSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No reviews yet. Be the first verified buyer to review this product."
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom action bar: Stepper + Total + Add to Cart -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/tirtir_white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layoutInlineQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quantity:"
                android:textColor="@color/tirtir_text_secondary"
                android:textSize="14sp"
                android:layout_marginEnd="16dp"/>
                
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_stepper"
                android:gravity="center_vertical">
                
                <ImageButton
                    android:id="@+id/btnDecreaseQty"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_minus"
                    app:tint="@color/tirtir_black"/>
                    
                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:gravity="center"
                    android:textColor="@color/tirtir_black"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                    
                <ImageButton
                    android:id="@+id/btnIncreaseQty"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/tirtir_black"/>
            </LinearLayout>
            
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
                
            <TextView
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textColor="@color/tirtir_red_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWishlist"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/content_desc_wishlist"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_wishlist"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/tirtir_red_primary"
                app:strokeColor="@color/tirtir_border_gray"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToCart"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/btn_add_to_cart"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/tirtir_black"
                app:backgroundTint="@color/tirtir_white"
                app:strokeColor="@color/tirtir_black"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuyNow"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Buy Now"
                android:textColor="@color/tirtir_white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/tirtir_red_dark"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
