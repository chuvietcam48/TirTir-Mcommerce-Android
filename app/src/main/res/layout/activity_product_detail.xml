<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tirtir_white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Section -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="400dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F3F3F4" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerProductImages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/ivProductDetailImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnImagePrevious"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    android:visibility="gone"
                    app:tint="@color/tirtir_text_secondary" />

                <ImageButton
                    android:id="@+id/btnImageNext"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    android:rotation="180"
                    android:visibility="gone"
                    app:tint="@color/tirtir_text_secondary" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabIndicatorImages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="24dp"
                    android:background="@android:color/transparent"
                    app:tabBackground="@drawable/tab_selector"
                    app:tabGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabMaxWidth="12dp"
                    app:tabMinWidth="12dp"
                    app:tabPaddingEnd="4dp"
                    app:tabPaddingStart="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnARTryOn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="40dp"
                    android:layout_marginEnd="24dp"
                    android:backgroundTint="#2B2D2D"
                    android:text="AR TRY-ON"
                    android:textColor="@color/tirtir_white"
                    android:textSize="12sp"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_scan"
                    app:iconTint="@color/tirtir_white" />

                <!-- Out of Stock Overlay -->
                <FrameLayout
                    android:id="@+id/tvProductOutOfStockBadge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#99000000"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="#4DFFFFFF"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="10dp"
                        android:text="Sold Out"
                        android:textColor="@color/tirtir_white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </FrameLayout>

            <!-- Content Card (Overlapping) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-40dp"
                android:background="@drawable/bg_bottom_sheet"
                android:elevation="8dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="32dp">

                <!-- Category & Badges -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvProductCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        android:text="SKINCARE"
                        android:textAllCaps="true"
                        android:textColor="@color/tirtir_red_primary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ic_link"
                            app:tint="#5F5E5E" />
                        <ImageView
                            android:id="@+id/btnWishlist"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_wishlist"
                            app:tint="#5F5E5E" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Title -->
                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="serif"
                    android:text="Product Name"
                    android:textColor="#1A1C1C"
                    android:textSize="28sp" />

                <!-- Price & Stars -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProductPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="1.000.000 đ"
                        android:textColor="@color/tirtir_red_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <!-- Optional Original Price & Discount -->
                    <TextView
                        android:id="@+id/tvProductOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:textColor="#636262"
                        android:textSize="14sp"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tvProductDiscountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_tag_primary"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/tirtir_white"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutRatingRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_star_filled"
                            app:tint="@color/tirtir_red_primary" />
                        <TextView
                            android:id="@+id/tvProductRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="4.9"
                            android:textColor="#5A403C"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="24dp"
                    android:background="#E2E2E2" />

                <!-- Grid Details (Skin Types, Ingredients) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Skin Types Section -->
                    <LinearLayout
                        android:id="@+id/layoutSkinTypesSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.05"
                            android:text="SUITABLE SKIN TYPES"
                            android:textAllCaps="true"
                            android:textColor="#1A1C1C"
                            android:textSize="14sp" />
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupSkinTypes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp" />
                        <TextView
                            android:id="@+id/tvSuitableSkinTypes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Shade Selection Section -->
                    <LinearLayout
                        android:id="@+id/layoutShadeSelection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.05"
                            android:text="SELECT SHADE"
                            android:textAllCaps="true"
                            android:textColor="#1A1C1C"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvSelectedShadeName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Select a shade"
                            android:textColor="#5F5E5E"
                            android:textSize="12sp" />
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">
                            <LinearLayout
                                android:id="@+id/layoutShadesContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <!-- Key Ingredients -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvHeaderIngredients"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.05"
                            android:text="KEY INGREDIENTS"
                            android:textAllCaps="true"
                            android:textColor="#1A1C1C"
                            android:textSize="14sp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginEnd="12dp"
                                android:background="@drawable/bg_circle_white"
                                android:padding="6dp"
                                android:src="@drawable/ic_routine"
                                app:tint="#2E7D32" />
                            <TextView
                                android:id="@+id/tvIngredientList"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ingredient list"
                                android:textColor="#5F5E5E"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- Ask AI Button (Mapped to btnAskAIBeforeBuying if exists, else we just use a generic ID) -->
                <!-- Assuming the user meant this to open Chat, I'll give it an ID. In ProductDetailActivity it uses bottom nav Chat. 
                     I will leave the ID so they can bind it later if needed. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAskAIBeforeBuying"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="24dp"
                    android:text="ASK AI BEFORE BUYING"
                    android:textColor="@color/tirtir_red_primary"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_scan"
                    app:iconTint="@color/tirtir_red_primary"
                    app:strokeColor="@color/tirtir_red_primary"
                    app:strokeWidth="1.5dp" />

                <!-- Description -->
                <TextView
                    android:id="@+id/tvHeaderDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="PRODUCT RITUAL"
                    android:textAllCaps="true"
                    android:textColor="#1A1C1C"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvProductDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:lineSpacingExtra="6dp"
                    android:text="Description goes here."
                    android:textColor="#5F5E5E"
                    android:textSize="16sp" />
                    
                <LinearLayout
                    android:id="@+id/layoutDescriptionImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Retain hidden views to satisfy ProductDetailActivity.java findViewById -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:orientation="vertical">
                    <TextView android:id="@+id/tvHeaderHowToUse" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvHowToUse" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvHeaderReviews" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvReviewSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <LinearLayout android:id="@+id/layoutFeatureBadges" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <View android:id="@+id/cardVeganFormula" android:layout_width="1dp" android:layout_height="1dp" />
                        <View android:id="@+id/cardDermatologistTested" android:layout_width="1dp" android:layout_height="1dp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/layoutInlineQuantity" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <ImageButton android:id="@+id/btnDecreaseQty" android:layout_width="1dp" android:layout_height="1dp" />
                        <TextView android:id="@+id/tvQuantity" android:layout_width="1dp" android:layout_height="1dp" />
                        <ImageButton android:id="@+id/btnIncreaseQty" android:layout_width="1dp" android:layout_height="1dp" />
                        <TextView android:id="@+id/tvTotalPrice" android:layout_width="1dp" android:layout_height="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Top Navigation Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#99FFFFFF"
        android:elevation="4dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/tirtir_red_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="serif"
            android:text="TirTir"
            android:textColor="@color/tirtir_red_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCartTopNav"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_cart"
            app:tint="@color/tirtir_red_primary" />
    </RelativeLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCart"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="Add to Cart"
            android:textColor="#2B2D2D"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_cart"
            app:iconTint="#2B2D2D"
            app:strokeColor="#2B2D2D" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuyNow"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1.5"
            android:backgroundTint="@color/tirtir_red_primary"
            android:text="Buy Now"
            android:textColor="@color/tirtir_white"
            android:textSize="14sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
