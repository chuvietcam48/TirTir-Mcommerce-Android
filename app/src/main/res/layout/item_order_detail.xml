<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_order_item"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Product Image -->
    <androidx.cardview.widget.CardView
        android:layout_width="72dp"
        android:layout_height="96dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/ivItemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/tirtir_bg_gray" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tirtir_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvItemVariant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_timeline_node_inactive"
            android:backgroundTint="@color/tirtir_bg_gray"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/tirtir_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvItemQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tirtir_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvItemPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/tirtir_red_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
