<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:background="@color/white">

    <!-- Product Image -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProductImage"
        android:layout_width="88dp"
        android:layout_height="88dp"
        app:cardBackgroundColor="#0F0F0F"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivCartProductImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_product_placeholder" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvCartProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Mask Fit Red Cushion"
        android:textColor="#00356B"
        android:fontFamily="serif"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardProductImage"
        app:layout_constraintTop_toTopOf="@id/cardProductImage" />

    <TextView
        android:id="@+id/tvCartVariant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_border_radius_24"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="Shade: 21N Ivory ⌄"
        android:textColor="#757575"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tvCartProductName"
        app:layout_constraintTop_toBottomOf="@id/tvCartProductName" />

    <!-- Quantity Selector -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_border_radius_24"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@id/cardProductImage"
        app:layout_constraintStart_toStartOf="@id/tvCartProductName">

        <ImageButton
            android:id="@+id/btnDecreaseQty"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_minus"
            android:padding="8dp"
            app:tint="#62718E" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="#00356B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnIncreaseQty"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_plus"
            android:padding="8dp"
            app:tint="#E64A19" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCartProductPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$24.99"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/cardProductImage"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Keep hidden views to avoid adapter null pointer or binding errors -->
    <TextView android:id="@+id/btnRemoveCartItem" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/tvCartBrand" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/tvSyncBadge" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
