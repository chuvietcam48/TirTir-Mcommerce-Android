<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tirtir_off_white">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tirtir_white"
        app:elevation="0dp">
        <include layout="@layout/layout_app_header" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="64dp">

            <!-- Avatar with circular progress -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp">

                <ProgressBar
                    android:id="@+id/pbLoyalty"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/circular_progress_bar"
                    android:max="1000"
                    android:progress="250" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:background="@color/tirtir_red_surface"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent" />

                <TextView
                    android:id="@+id/tvInitials"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:background="@drawable/ic_tirtir_brand_circle"
                    android:textColor="@color/tirtir_red_primary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:text="TT" />

                <ProgressBar
                    android:id="@+id/progressAvatarUpload"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/tirtir_red_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Name -->
            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Name"
                android:textColor="@color/tirtir_black"
                android:textSize="22sp"
                android:textStyle="normal"
                android:fontFamily="serif" />

            <!-- Hidden Views (kept to avoid Java NullPointerExceptions or complex edits) -->
            <TextView android:id="@+id/tvEmail" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvLoyaltyProgress" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <View android:id="@+id/cardLoyalty" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <View android:id="@+id/btnEditProfile" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAddresses" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            <!-- Tier and Points -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvLoyaltyTierBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_red_outline"
                    android:backgroundTint="#333333"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="SILVER"
                    android:textColor="@color/tirtir_white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tvLoyaltyPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="1,250 points"
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Skin Types -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSkinType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="24dp"
                app:singleSelection="true"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                android:gravity="center">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSkinCombo"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="@color/chip_stroke_profile"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_profile"
                    android:text="COMBINATION" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSkinOily"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="@color/chip_stroke_profile"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_profile"
                    android:text="OILY" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSkinDry"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="@color/chip_stroke_profile"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_profile"
                    android:text="DRY" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSkinSensitive"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="@color/chip_stroke_profile"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_profile"
                    android:text="SENSITIVE" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSkinNormal"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="@color/chip_stroke_profile"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_profile"
                    android:text="NORMAL" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Menu List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR ACCOUNT"
                    android:textSize="10sp"
                    android:textColor="@color/tirtir_text_secondary"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="8dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/tirtir_white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="8dp">

                        <!-- My Orders -->
                        <LinearLayout
                            android:id="@+id/layoutMyOrders"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="20dp"
                            android:background="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_product_placeholder"
                                app:tint="@color/tirtir_red_primary" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:text="My Orders"
                                android:textColor="@color/tirtir_black"
                                android:textSize="15sp" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/tirtir_text_secondary" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" android:layout_marginHorizontal="20dp"/>

                        <!-- My Addresses -->
                        <LinearLayout
                            android:id="@+id/layoutMyAddresses"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="20dp"
                            android:background="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_mylocation"
                                app:tint="@color/tirtir_red_primary" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:text="My Addresses"
                                android:textColor="@color/tirtir_black"
                                android:textSize="15sp" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/tirtir_text_secondary" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" android:layout_marginHorizontal="20dp"/>

                        <!-- Wishlist -->
                        <LinearLayout
                            android:id="@+id/layoutMyWishlist"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="20dp"
                            android:background="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_wishlist"
                                app:tint="@color/tirtir_red_primary" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:text="Wishlist"
                                android:textColor="@color/tirtir_black"
                                android:textSize="15sp" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/tirtir_text_secondary" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" android:layout_marginHorizontal="20dp"/>

                        <!-- Scan history -->
                        <LinearLayout
                            android:id="@+id/layoutScanHistory"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="20dp"
                            android:background="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_skin"
                                app:tint="@color/tirtir_red_primary" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:text="Skin analysis"
                                android:textColor="@color/tirtir_black"
                                android:textSize="15sp" />
                            <TextView
                                android:id="@+id/tvScanHistoryStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VIEW"
                                android:textColor="@color/tirtir_text_secondary"
                                android:textSize="10sp"
                                android:layout_marginEnd="8dp" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/tirtir_text_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="44dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Sign Out"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:textColor="@color/tirtir_red_primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/tirtir_red_primary"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="12dp" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
