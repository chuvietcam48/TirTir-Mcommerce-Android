<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="142dp"
        app:cardBackgroundColor="@color/tirtir_off_white"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ivRoutinePickerProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Product"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_product_placeholder" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoutinePickerAdd"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:contentDescription="Add product"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/tirtir_white"
                android:textSize="22sp"
                app:backgroundTint="@color/tirtir_red_primary"
                app:cornerRadius="22dp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvRoutinePickerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/tirtir_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRoutinePickerCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tirtir_text_secondary"
        android:textSize="11sp" />

</LinearLayout>
