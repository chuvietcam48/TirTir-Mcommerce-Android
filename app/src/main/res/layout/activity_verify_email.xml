<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tirtir_off_white">

    <!-- Custom Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetStartWithNavigation="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT RECOVERY"
            android:textColor="@color/tirtir_red_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_gravity="center" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Content Card (Centered) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/tirtir_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Verify Email"
                    android:textColor="@color/tirtir_red_dark"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvVerifySubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="We've sent a 4-digit code to\ncurator@tirtir.beauty"
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="40dp" />

                <!-- OTP Input Layout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="48dp">

                    <EditText
                        android:id="@+id/otp1"
                        android:layout_width="48dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="24sp"
                        android:textColor="@color/tirtir_black"
                        android:layout_marginEnd="12dp"/>

                    <EditText
                        android:id="@+id/otp2"
                        android:layout_width="48dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_auth_underline"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="24sp"
                        android:textColor="@color/tirtir_black"
                        android:layout_marginEnd="12dp"/>

                    <EditText
                        android:id="@+id/otp3"
                        android:layout_width="48dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_auth_underline"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="24sp"
                        android:textColor="@color/tirtir_black"
                        android:layout_marginEnd="12dp"/>

                    <EditText
                        android:id="@+id/otp4"
                        android:layout_width="48dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_auth_underline"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="24sp"
                        android:textColor="@color/tirtir_black"/>
                </LinearLayout>

                <!-- Verify Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerify"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="@color/tirtir_dark_gray_btn"
                    android:text="VERIFY"
                    android:textColor="@color/tirtir_white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    app:cornerRadius="4dp"
                    android:layout_marginBottom="24dp" />

                <!-- Resend Code -->
                <TextView
                    android:id="@+id/tvResend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESEND CODE"
                    android:textColor="@color/tirtir_text_secondary"
                    android:textSize="13sp"
                    android:letterSpacing="0.05"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2024 TIR TIR BEAUTY"
            android:textColor="@color/tirtir_silver_gray"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16dp"/>

    </FrameLayout>
</LinearLayout>
