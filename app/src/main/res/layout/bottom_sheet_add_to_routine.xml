<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tirtir_white"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/tirtir_border_gray" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvRoutinePickerTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:fontFamily="serif"
                android:text="Add to Routine" android:textColor="@color/tirtir_red_dark"
                android:textSize="25sp" />
            <TextView android:id="@+id/tvRoutinePickerContext" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:text="Recommended for your skin and recent purchases"
                android:textColor="@color/tirtir_text_secondary" android:textSize="11sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/btnCloseRoutinePicker" android:layout_width="44dp"
            android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" android:src="@drawable/ic_close"
            app:tint="@color/tirtir_text_secondary" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsRoutinePicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:selectionRequired="true"
            app:singleSelection="true"
            app:chipSpacingHorizontal="8dp" />
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="16dp"
        android:text="RECOMMENDED FOR YOU"
        android:textColor="@color/tirtir_red_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoutinePickerProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="10dp"
        android:paddingBottom="28dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2" />

</LinearLayout>
