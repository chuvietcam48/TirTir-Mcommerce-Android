<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_rounded_border"
    android:backgroundTint="@color/tirtir_white"
    android:elevation="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">
        
        <ImageView
            android:id="@+id/ivAdminProductThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/tirtir_surface_container"
            tools:src="@android:color/darker_gray"/>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            
            <TextView
                android:id="@+id/tvAdminProductStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="IN STOCK"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#15803d"
                android:background="@drawable/bg_rounded_border"
                android:backgroundTint="#f0fdf4" />
                
            <TextView
                android:id="@+id/tvAdminProductStockCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="142 in stock"
                android:textSize="12sp"
                android:textColor="@color/tirtir_text_secondary"
                android:background="@drawable/bg_rounded_border"
                android:backgroundTint="@color/tirtir_surface_container" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAdminProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Red Ginseng Renewal Serum"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/tirtir_black"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvAdminProductMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skincare • SKU: SK-RG-001"
            android:textSize="12sp"
            android:textColor="@color/tirtir_text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvAdminProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="$185.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/tirtir_primary" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/tirtir_outline_variant" />

</LinearLayout>
