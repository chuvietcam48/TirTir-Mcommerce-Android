<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Permissions cho Camera và Gallery (Avatar upload) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- ARCore -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="true" />
    <!-- Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android < 13 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TirTirMCommerce"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />

        <meta-data
            android:name="com.google.ar.core"
            android:value="required" />

        <!-- SCR-00: SplashActivity (kept but no longer launcher) -->
        <activity
            android:name=".ui.activities.SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.TirTirMCommerce" />

        <!-- SCR-01: OnboardingActivity (kept but skipped) -->
        <activity
            android:name=".ui.activities.OnboardingActivity"
            android:exported="false" />

        <!-- SCR-10: LoginActivity — LAUNCHER (entry point) -->
        <activity
            android:name=".ui.activities.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activities.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.VerifyEmailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.NewPasswordActivity"
            android:exported="false" />

        <!-- SCR-11: RegisterActivity -->
        <activity
            android:name=".ui.activities.RegisterActivity"
            android:exported="false" />

        <!-- SCR-12: MainActivity (bottom nav host) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- VNPAY return deep-link: tirtir://payment?status=success&orderId=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tirtir" android:host="payment" />
            </intent-filter>
        </activity>

        <!-- SCR-14: ProductDetailActivity -->
        <activity
            android:name=".ui.activities.ProductDetailActivity"
            android:exported="false" />

        <!-- PHASE 3: AI / ML + deploy-ready frontend flows -->
        <activity
            android:name=".ui.activities.ChatActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.IngredientScanActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.ConflictResultActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.IngredientHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.SkinAnalysisActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.SkinResultActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.ARTryOnActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.NotificationSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.NotificationCenterActivity"
            android:exported="false" />

        <!-- SCR-16: CheckoutActivity -->
        <activity
            android:name=".ui.activities.CheckoutActivity"
            android:exported="false" />

        <!-- SCR-17: OrderSuccessActivity -->
        <activity
            android:name=".ui.activities.OrderSuccessActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.OrderDetailActivity"
            android:exported="false" />

        <!-- SCR-1A: AddressManagerActivity -->
        <activity
            android:name=".ui.activities.AddressManagerActivity"
            android:exported="false" />

        <!-- SCR-1B: WishlistActivity -->
        <activity
            android:name=".ui.activities.WishlistActivity"
            android:exported="false" />

        <!-- AdminActivity - Màn hình dành cho role admin -->
        <activity
            android:name=".ui.activities.AdminActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.AdminProductListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.AdminProductFormActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.AdminOrdersActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.AdminOrderDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.AdminChurnActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.AdminCartRecoveryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.BarcodeScanActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.VoucherWalletActivity"
            android:exported="false" />

        <!-- FileProvider - Dùng cho Camera intent (Android 7+) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.tirtir_mcommerce.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- ContentProvider: WishlistContentProvider (Android Component - Syllabus) -->
        <provider
            android:name=".WishlistContentProvider"
            android:authorities="com.example.tirtir_mcommerce.provider"
            android:exported="false" />

        <!-- Firebase Messaging Service -->
        <service
            android:name=".TirTirFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".utils.AlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver android:name=".receivers.RoutineReminderReceiver"
            android:exported="false" />

    </application>

</manifest>
